+		extern void opi5plus_trace_spawn_entry(proc_t, user_addr_t, int, int *);
+		int opi5plus_blocked = opi5plus_block_exec_path(uap->path);
+
+		opi5plus_trace_spawn_entry(p, uap->path, opi5plus_blocked, &opi5plus_spawn_traced_entry);
+		if (opi5plus_blocked != 0) {
+			return opi5plus_blocked;
