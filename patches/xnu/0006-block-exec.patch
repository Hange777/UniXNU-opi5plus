+/*
+ * Orange Pi 5 Plus: refuse to exec a named program.
+ *
+ * A daemon that cannot start still holds the launchd job that backs its XPC service, and launchd answers a
+ * request for that service by starting the job: SpringBoard's synchronous -[MadGate getActivationState:] then
+ * waits for a reply that never comes, for the rest of the boot (evidence/m7/M7-08). mobileactivationd is the
+ * case this exists for -- it dies by design in its own main() error path (evidence/m7/M7-09) -- and refusing
+ * the exec makes launchd fail the request instead of queueing it, which is what lets the caller move on.
+ *
+ *	opi5plus-block-exec=mobileactivationd	comma separated, matched against the program's basename
+ *
+ * Two call sites, because launchd starts jobs with posix_spawn(2), which builds and executes the image
+ * inside the kernel and never reaches execve(): the check runs at the top of both. An experiment switch:
+ * nothing happens unless the argument is present.
+ */
+int
+opi5plus_block_exec_path(user_addr_t path_pointer)
+{
+	static char list[160];
+	static int ready = 0;
+	char path[128];
+	size_t length = 0;
+	const char *base;
+
+	if (!ready) {
+		ready = 1;
+		(void) PE_parse_boot_argn("opi5plus-block-exec", list, sizeof(list));
+	}
+	if (list[0] == 0) {
+		return 0;
+	}
+	if (copyinstr(path_pointer, path, sizeof(path), &length) != 0 || length == 0) {
+		return 0;
+	}
+	base = strrchr(path, '/');
+	base = (base != NULL) ? (base + 1) : path;
+	if (base[0] == 0 || strnstr(list, base, sizeof(list)) == NULL) {
+		return 0;
+	}
+	printf("opi5plus: exec of %s blocked (opi5plus-block-exec=%s)\n", path, list);
+	return EPERM;
+}
+
+/*
+ * Orange Pi 5 Plus: trace every posix_spawn at the top where block-exec runs (round 20).
+ *
+ * The r14 dead end: apps opened from the desktop spawned successfully and never rendered, so the
+ * spawn path itself is the next thing on the UART. The entry line names the caller and the target;
+ * the return line pairs with it by pid and carries posix_spawn's own error. The return value is
+ * only knowable at the function's single tail (every error path converges on its bad: label), and
+ * the caller pid is kept from the top because a spawn with POSIX_SPAWN_SETEXEC replaces the caller
+ * before the tail runs. A refused spawn (block-exec) always prints, path and return together; the
+ * ordinary ones stop after a per-boot soft cap of 512 printed spawns and are counted, with one
+ * tally line per 256 suppressed, so a boot whose launchd spawns hundreds does not drown the UART
+ * while the first hundreds stay verbatim.
+ *
+ *	opi5plus-trace-spawn=1	switches the whole thing on; without it nothing prints
+ */
+static int opi5plus_spawn_trace_on = -1;      /* -1 = the boot argument is not parsed yet */
+static unsigned opi5plus_spawn_trace_count = 0, opi5plus_spawn_trace_skipped = 0;
+
+void
+opi5plus_trace_spawn_entry(proc_t caller, user_addr_t path_pointer, int blocked, int *traced)
+{
+	char path[128];
+	size_t length = 0;
+	uint32_t on = 0;
+
+	*traced = 0;
+	if (opi5plus_spawn_trace_on < 0) {
+		opi5plus_spawn_trace_on =
+		    (PE_parse_boot_argn("opi5plus-trace-spawn", &on, sizeof(on)) && on != 0) ? 1 : 0;
+	}
+	if (opi5plus_spawn_trace_on == 0) {
+		return;
+	}
+	if (blocked != 0) {
+		if (copyinstr(path_pointer, path, sizeof(path), &length) != 0 || length == 0) {
+			strlcpy(path, "?", sizeof(path));
+		}
+		printf("opi5plus: spawn pid=%d ret=%d path=%s (block-exec)\n",
+		    proc_getpid(caller), blocked, path);
+		return;
+	}
+	if (opi5plus_spawn_trace_count >= 512) {
+		opi5plus_spawn_trace_skipped = opi5plus_spawn_trace_skipped + 1;
+		if ((opi5plus_spawn_trace_skipped % 256) == 0) {
+			printf("opi5plus: spawn trace capped at 512, %u more suppressed\n",
+			    opi5plus_spawn_trace_skipped);
+		}
+		return;
+	}
+	if (copyinstr(path_pointer, path, sizeof(path), &length) != 0 || length == 0) {
+		strlcpy(path, "?", sizeof(path));
+	}
+	printf("opi5plus: spawn pid=%d path=%s\n", proc_getpid(caller), path);
+	opi5plus_spawn_trace_count = opi5plus_spawn_trace_count + 1;
+	*traced = 1;
+}
+
+void
+opi5plus_trace_spawn_ret(pid_t caller, int error)
+{
+	if (opi5plus_spawn_trace_on != 1) {
+		return;
+	}
+	printf("opi5plus: spawn pid=%d ret=%d\n", caller, error);
+}
 #endif /* DEVELOPMENT || DEBUG */
