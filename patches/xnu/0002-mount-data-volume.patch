+		const char *path;
+		int mode;
+		uid_t uid;
+		gid_t gid;
+	} dirs[] = {
+		{ "/private/var/db", 0755, 0, 0 },
+		{ "/private/var/db/timezone", 0755, 0, 0 },
+		{ "/private/var/db/diagnostics", 0755, 0, 0 },
+		{ "/private/var/db/uuidtext", 0755, 0, 0 },
+		{ "/private/var/mobile", 0755, 501, 501 },
+		{ "/private/var/mobile/tmp", 0755, 501, 501 },
+		{ "/private/var/mobile/Library", 0755, 501, 501 },
+		{ "/private/var/vm", 0755, 0, 0 },
+		{ "/private/var/tmp", 01777, 0, 0 },
+		{ "/private/var/keybags", 0755, 0, 0 },
+		{ "/private/var/preferences", 0755, 0, 0 },
+		{ "/private/var/root", 0700, 0, 0 },
+		{ "/private/var/run", 0755, 0, 0 },
+		{ "/private/var/log", 0755, 0, 0 },
+		{ "/private/var/protected", 0755, 0, 0 },
