+#if DEVELOPMENT || DEBUG
+/*
+ * Why a boot stops before the UI: the six daemons that walk the Data volume, and only the calls that fail.
+ * A path argument is a user pointer, so it is read back with copyinstr() at the point where the errno exists.
+ * Names are matched as prefixes: the kernel cuts p_comm to about fifteen characters.
+ */
+#define OPI5PLUS_SYSCALL_PER_NAME 40
+#define OPI5PLUS_SYSCALL_SLOTS 16
+#define OPI5PLUS_SYSCALL_PATH 96
+#define OPI5PLUS_SYSCALL_F_GETPATH 50
+
+static const char *opi5plus_syscall_watch[] = {
+	"biomed",
+	"callservicesd",
+	"nsurlsessiond",
+	"biomesyncd",
+	"keybagd",
+	"contextstored",
+};
+#define OPI5PLUS_SYSCALL_NAMES (sizeof(opi5plus_syscall_watch) / sizeof(opi5plus_syscall_watch[0]))
+
+/*
+ * One slot per thread: the entry hook records the call number and where its path argument lives, the return
+ * hook reads it back once the errno is known. Keyed by thread, not by pid -- these daemons run the same call
+ * from several threads at once, and a pid-keyed table would print one thread's path next to another's errno.
+ */
+struct opi5plus_syscall_slot {
+	thread_t thread;
+	uint64_t path;
+	int nr;
+	int reg;
+	int watch;
+	int pid;
+	char comm[24];
+	int live;
+};
+static struct opi5plus_syscall_slot opi5plus_syscall_slots[OPI5PLUS_SYSCALL_SLOTS];
+static int opi5plus_syscall_counts[OPI5PLUS_SYSCALL_NAMES];
+static int opi5plus_syscall_enabled = -1;
+
+static int
+opi5plus_syscall_ready(void)
+{
+	if (opi5plus_syscall_enabled < 0) {
+		uint32_t value = 0;
+		(void) PE_parse_boot_argn("sd-syscall", &value, sizeof(value));
+		opi5plus_syscall_enabled = value != 0;
+	}
+	return opi5plus_syscall_enabled;
+}
+
+/* strncmp() without <string.h>, for the same answer with one loop. */
+static int
+opi5plus_syscall_prefix(const char *text, const char *prefix)
+{
+	while (*prefix != 0) {
+		if (*text++ != *prefix++) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* The index of the watched name this process matches, -1 for a process that is not watched. */
+static int
+opi5plus_syscall_watched(const char *comm)
+{
+	for (unsigned i = 0; i < OPI5PLUS_SYSCALL_NAMES; ++i) {
+		if (opi5plus_syscall_prefix(comm, opi5plus_syscall_watch[i])) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/*
+ * Where the path argument of a call number sits in the saved state, -1 when the call takes none.
+ * fcntl(2) is the special case: x1 is the command, and F_GETPATH (50) has the file system write the path into
+ * the buffer at x2, so that path only exists once the call has run.
+ * fchmod(124) takes a descriptor and a mode and no path at all, and syscall 50 is setlogin -- realpath(3)
+ * reaches the kernel through F_GETPATH, not through a call number of its own.
+ */
+static int
+opi5plus_syscall_path_register(int nr, struct arm_saved_state *state)
+{
+	switch (nr) {
+	case 5:                 /* open */
+	case 136:               /* mkdir */
+	case 188: case 190:     /* stat, lstat */
+	case 338: case 340:     /* stat64, lstat64 */
+	case 33:                /* access */
+	case 58:                /* readlink */
+	case 220:               /* getattrlist */
+	case 10:                /* unlink */
+	case 128:               /* rename */
+	case 15:                /* chmod */
+		return 0;
+	case 463:               /* openat */
+	case 216:               /* open_dprotected_np */
+	case 475:               /* mkdirat */
+		return 1;
+	case 92:                /* fcntl */
+		if (state != NULL && (int)get_saved_state_reg(state, 1) == OPI5PLUS_SYSCALL_F_GETPATH) {
+			return 2;
+		}
+		return -1;
+	default:
+		return -1;
+	}
+}
+
+static struct opi5plus_syscall_slot *
+opi5plus_syscall_slot(thread_t thread)
+{
+	struct opi5plus_syscall_slot *free_slot = NULL;
+
+	for (unsigned i = 0; i < OPI5PLUS_SYSCALL_SLOTS; ++i) {
+		if (opi5plus_syscall_slots[i].live && opi5plus_syscall_slots[i].thread == thread) {
+			return &opi5plus_syscall_slots[i];
+		}
+		if (!opi5plus_syscall_slots[i].live && free_slot == NULL) {
+			free_slot = &opi5plus_syscall_slots[i];
+		}
+	}
+	return free_slot;
+}
+
+void
+opi5plus_trace_syscall(struct proc *p, int code, struct arm_saved_state *state)
+{
+	struct opi5plus_syscall_slot *slot;
+	int watch;
+	int reg;
+
+	if (!opi5plus_syscall_ready() || p == NULL) {
+		return;
+	}
+	watch = opi5plus_syscall_watched(p->p_comm);
+	if (watch < 0) {
+		return;
+	}
+	slot = opi5plus_syscall_slot(current_thread());
+	if (slot == NULL) {
+		return;
+	}
+	reg = opi5plus_syscall_path_register(code, state);
+	slot->thread = current_thread();
+	slot->nr = code;
+	slot->reg = reg;
+	slot->watch = watch;
+	slot->pid = p->p_pid;
+	slot->comm[0] = 0;
+	for (int i = 0; i < (int)sizeof(slot->comm) - 1 && p->p_comm[i] != 0; ++i) {
+		slot->comm[i] = p->p_comm[i];
+		slot->comm[i + 1] = 0;
+	}
+	slot->path = (reg < 0 || state == NULL) ? 0 : (uint64_t)get_saved_state_reg(state, reg);
+	slot->live = 1;
+}
+
+/*
+ * Called from unix_syscall() right after the system call returned: the one place where the errno and the still
+ * untouched argument registers exist together -- arm_prepare_syscall_return(), which overwrites x0 with the
+ * error, runs further down that function.
+ */
+void
+opi5plus_trace_syscall_return(int code, int error)
+{
+	struct opi5plus_syscall_slot *slot;
+	char path[OPI5PLUS_SYSCALL_PATH];
+	size_t taken = 0;
+
+	if (!opi5plus_syscall_ready()) {
+		return;
+	}
+	slot = opi5plus_syscall_slot(current_thread());
+	if (slot == NULL || !slot->live || slot->nr != code) {
+		return;
+	}
+	slot->live = 0;
+	/* ERESTART and EJUSTRETURN are negative and mean the call did not return here; only an errno counts. */
+	if (error <= 0) {
+		return;
+	}
+	/*
+	 * ENOENT is the normal answer to a daemon probing for a file or a directory it does not need yet, not a
+	 * failing call: in round 1 it alone took 31 of callservicesd's 40 lines and 33 of contextstored's, and
+	 * the calls that actually failed never reached the log. The quota and the counters are unchanged.
+	 */
+	if (error == ENOENT) {
+		return;
+	}
+	if (opi5plus_syscall_counts[slot->watch] >= OPI5PLUS_SYSCALL_PER_NAME) {
+		return;
+	}
+	opi5plus_syscall_counts[slot->watch]++;
+	if (slot->reg >= 0 && slot->path != 0 &&
+	    copyinstr((user_addr_t)slot->path, path, sizeof(path), &taken) == 0) {
+		printf("opi5plus: sysnum %s[%d] nr %d errno %d path %s\n", slot->comm, slot->pid, code, error,
+		    path);
+	} else {
+		printf("opi5plus: sysnum %s[%d] nr %d errno %d path <nopath>\n", slot->comm, slot->pid, code,
+		    error);
+	}
+}
+#endif /* DEVELOPMENT || DEBUG */
