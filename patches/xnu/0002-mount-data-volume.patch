+		{ "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobileactivationd/Library/ucrt", 0755, 0, 0 },
+		{ "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobileactivationd/Library/dcrt", 0755, 0, 0 },
+		{ "/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobileactivationd/Library/internal", 0755, 0, 0 },
+		{ "/private/var/containers/Data", 0755, 0, 0 },
+		{ "/private/var/containers/Data/System", 0755, 0, 0 },
+		{ "/private/var/hardware", 0755, 0, 0 },
+		{ "/private/var/hardware/MobileActivation", 0755, 0, 0 },
