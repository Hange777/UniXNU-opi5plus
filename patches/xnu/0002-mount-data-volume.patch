+/*
+ * Orange Pi 5 Plus: the page counters of the beat line (vfree, vspec, vcomp). A bsd object cannot include
+ * <vm/vm_page.h> itself -- the header is not exported, and its kern/misc_protos.h declares setbit(), which
+ * bsd/sys/param.h already defines as a macro -- so the numbers cross over here.
+ */
+void
+opi5plus_vm_page_counts(unsigned long long *free_pages, unsigned long long *speculative_pages,
+    unsigned long long *compressor_pages)
+{
+	if (free_pages != NULL) {
+		*free_pages = vm_page_free_count;
+	}
+	if (speculative_pages != NULL) {
+		*speculative_pages = vm_page_speculative_count;
+	}
+	if (compressor_pages != NULL) {
+		*compressor_pages = (unsigned long long)VM_PAGE_COMPRESSOR_COUNT;
+	}
+}
