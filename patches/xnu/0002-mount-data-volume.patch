+
+static int
+opi5plus_apfs_mount(proc_t p, user_addr_t scratch, const char *path, const char *device_path, int flags)
+{
+	uint8_t mount_data[0x150] = {0};
+	user_addr_t spec = scratch + 0x160;
+	uint64_t apfs_flags = (flags & MNT_RDONLY) ? MNT_RDONLY : 0;
+	uint16_t mount_mode = 1;
+	uint32_t anonymous_owner = 99;
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120, .flags = flags,
+	    .data = scratch + 0x200};
+	int32_t result = 0;
+	int error;
+
+	memcpy(mount_data, &spec, sizeof(spec));
+	memcpy(mount_data + 8, &apfs_flags, sizeof(apfs_flags));
+	memcpy(mount_data + 16, &mount_mode, sizeof(mount_mode));
+	memcpy(mount_data + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(mount_data + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	if ((error = copyout("apfs", request.type, 5)) != 0 ||
+	    (error = copyout(path, request.path, strlen(path) + 1)) != 0 ||
+	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
+	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) {
+		return error;
+	}
+	return mount(p, &request, &result);
+}
+
+/* The mount opi5plus_userland_prepare put on /private/var, kept for the beat line's free-block count: the
+ * mount lives as long as the system does, so the pointer is read back under vfs_isunmount() rather than
+ * dereferenced blindly. */
+static mount_t opi5plus_data_mount;
+
+/*
+ * Owner, group and mode of the paths the userland has to write, once the seed is done: a boot that fails in
+ * its first seconds then says which directory came out wrong instead of only that something could not create
+ * a file. vnode_getattr() is the KPI here (struct vnode_attr, not the older struct vattr), and it is asked
+ * only for the three fields printed.
+ */
+static void
+opi5plus_report_perms(void)
+{
+	static const char *paths[] = {
+		"/private/var",
+		"/private/var/mobile",
+		"/private/var/mobile/Library",
+		"/private/var/mobile/tmp",
+		"/private/var/tmp",
+		"/private/var/db",
+		"/private/var/db/biome",
+		"/private/var/containers",
+	};
+	vfs_context_t ctx = vfs_context_kernel();
+
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); ++i) {
+		struct vnode_attr va;
+		vnode_t vp = NULLVP;
+		int rc = vnode_lookup(paths[i], 0, &vp, ctx);
+
+		if (rc == 0 && vp != NULLVP) {
+			VATTR_INIT(&va);
+			VATTR_WANTED(&va, va_uid);
+			VATTR_WANTED(&va, va_gid);
+			VATTR_WANTED(&va, va_mode);
+			rc = vnode_getattr(vp, &va, ctx);
+			vnode_put(vp);
+			if (rc == 0) {
+				printf("opi5plus: stat %s rc 0 uid %u gid %u mode 0%o\n", paths[i],
+				    (unsigned)va.va_uid, (unsigned)va.va_gid, (unsigned)va.va_mode);
+				continue;
+			}
+		}
+		printf("opi5plus: stat %s rc %d uid -1 gid -1 mode 0\n", paths[i], rc);
+	}
+}
+
+int
+opi5plus_userland_prepare(proc_t p, user_addr_t scratch)
+{
+	static int attempted = 0;
+	char device_path[32] = {0};
+	int32_t device = 0;
+	uint32_t union_enable = 1, data_enable = 1;
+	int error;
+
+	if (attempted) {
+		return 0;
+	}
+	attempted = 1;
+	{
+		extern void opi5plus_start_ps_thread(void);
+		opi5plus_start_ps_thread();
+	}	(void) PE_parse_boot_argn("sd-systemos-union", &union_enable, sizeof(union_enable));
+	(void) PE_parse_boot_argn("sd-data-mount", &data_enable, sizeof(data_enable));
+
+	/*
+	 * The dyld shared cache is in the SystemOS cryptex, not on the OS volume: mount that volume read-only
+	 * over "/" as the upper layer of a union so /System/Library/Caches/com.apple.dyld is where iPadOS looks
+	 * for it. dyld flag bit 3 then says the images in this mode are vouched for by the owner chain and the
+	 * read-only mount rather than by an Image4 manifest, so ignition is not run for them.
+	 */
+	if (union_enable) {
+		if (!native_sd_volume_device("8846FE78-2910-4297-AF97-D59BB6F8FC16", device_path,
+		    sizeof(device_path), &device)) {
+			printf("opi5plus: no SystemOS volume published; the dyld shared cache stays out of reach\n");
+		} else {
+			printf("opi5plus: SystemOS volume %s (device %u,%u) goes over / as a union\n", device_path,
+			    major(device), minor(device));
+			error = opi5plus_apfs_mount(p, scratch, "/", device_path, MNT_RDONLY | MNT_UNION);
+			if (error) {
+				printf("opi5plus: SystemOS union over / failed: %d\n", error);
+			} else {
+				dyld_flags |= UINT64_C(8);
+				commpage_update_dyld_flags(dyld_flags);
+				printf("opi5plus: / is a union with the SystemOS cryptex; dyld ignition disabled\n");
+			}
+		}
+	}
+
+	if (!data_enable) {
+		printf("opi5plus: sd-data-mount=0, /private/var left as it is\n");
+		return 0;
+	}
+	if (!native_sd_data_device(device_path, sizeof(device_path), &device)) {
+		printf("opi5plus: no Data volume published; /private/var stays on the OS volume\n");
+		return ENOENT;
+	}
+	printf("opi5plus: Data volume %s (device %u,%u) goes on /private/var\n", device_path, major(device),
+	    minor(device));
+	/* MNT_UNION is off by default now, and the board said why: with the union, `/private/var/mobile` comes from
+	 * the read-only OS volume underneath, and launchd's own `fixup-mobile-tmp` boot task failed on it with
+	 * "could not set create /private/var/mobile/tmp: Read-only file system". A writable but empty volume is
+	 * what the boot tasks need to make their directories in; sd-data-union=1 brings the union back. */
+	{
+		uint32_t uniondata = 0;
+		(void) PE_parse_boot_argn("sd-data-union", &uniondata, sizeof(uniondata));
+		error = opi5plus_apfs_mount(p, scratch, "/private/var", device_path,
+		    uniondata != 0 ? MNT_UNION : 0);
+		if (error == 0) {
+			printf("opi5plus: /private/var mounted%s\n", uniondata != 0 ? " as a union" : "");
+		}
+	}
+	if (error) {
+		printf("opi5plus: mounting %s on /private/var failed: %d\n", device_path, error);
+		return error;
+	}
+	printf("opi5plus: /private/var is the Data volume now\n");
+	/* Hold on to the mount: vfs_statfs() on it answers from the cached statistics. */
+	{
+		vnode_t data_root = NULLVP;
+
+		if (vnode_lookup("/private/var", 0, &data_root, vfs_context_kernel()) == 0 &&
+		    data_root != NULLVP) {
+			opi5plus_data_mount = vnode_mount(data_root);
+			vnode_put(data_root);
+		}
+	}
+	{
+		uint32_t skeleton = 1;
+		(void) PE_parse_boot_argn("sd-data-skeleton", &skeleton, sizeof(skeleton));
+		if (skeleton != 0) {
+			opi5plus_ensure_dirs(p, scratch);
+		}
+	}
+	/* Every boot, before launchd runs: the MobileGestalt caches go (opi5plus_wipe_mobilegestalt). */
+	opi5plus_wipe_mobilegestalt(p, scratch);
+	{
+		/* Then, once per volume, the first-boot seed: the OS volume's /private/var tree, the runtime
+		 * directories and the preference plists that skip the Setup assistant. sd-data-seed=0 leaves the
+		 * volume alone, which is the way back if the seed itself is what a boot trips over. */
+		uint32_t seed = 1;
+		vnode_t data_root = NULLVP;
+
+		(void) PE_parse_boot_argn("sd-data-seed", &seed, sizeof(seed));
+		if (seed == 0) {
+			printf("opi5plus: seed: sd-data-seed=0, the Data volume is left as it is\n");
+		} else if (vnode_lookup("/private/var", 0, &data_root, vfs_context_kernel()) != 0 ||
+		    data_root == NULLVP) {
+			printf("opi5plus: seed: /private/var does not resolve on the Data volume, nothing seeded\n");
+		} else {
+			opi5plus_seed_tree(p, scratch, vnode_mount(data_root));
+			vnode_put(data_root);
+		}
+	}
+	/*
+	 * Arm the RK3588 watchdog last, once the mounts are in: from here on the heartbeat thread kicks it every
+	 * five seconds, so a kernel that stops running is a reset instead of a board that has to be unplugged.
+	 */
+	{
+		uint32_t watchdog = 15;
+		(void) PE_parse_boot_argn("sd-watchdog", &watchdog, sizeof(watchdog));
+		if (watchdog != 0) {
+			if (native_sd_watchdog_start(watchdog)) {
+				printf("opi5plus: watchdog armed (timeout index %u)\n", watchdog);
+			} else {
+				/* Worth a line of its own: without it, only a panic resets this board. */
+				printf("opi5plus: watchdog NOT armed (timeout index %u)\n", watchdog);
+			}
+		}
+	}
+	opi5plus_check_paths();
+	{
+		/* What the display drivers will see: GopFramebuffer compares this console with its device memory. */
+		extern int PE_current_console(PE_Video * info);
+		PE_Video video;
+		int result = PE_current_console(&video);
+		opi5plus_pe_puts("\r\nopi5plus: console result ");
+		opi5plus_pe_number((unsigned long long)result);
+		opi5plus_pe_puts(" base ");
+		opi5plus_pe_number((unsigned long long)video.v_baseAddr);
+		opi5plus_pe_puts(" row ");
+		opi5plus_pe_number((unsigned long long)video.v_rowBytes);
+		opi5plus_pe_puts(" w ");
+		opi5plus_pe_number((unsigned long long)video.v_width);
+		opi5plus_pe_puts(" h ");
+		opi5plus_pe_number((unsigned long long)video.v_height);
+		opi5plus_pe_puts(" depth ");
+		opi5plus_pe_number((unsigned long long)video.v_depth);
+		opi5plus_pe_puts("\r\n");
+	}
+	{
+		uint32_t paint = 0;
+		(void) PE_parse_boot_argn("sd-paint", &paint, sizeof(paint));
+		if (paint != 0) {
+			opi5plus_paint_screen();
+		}
+	}
+	/* Last, after the seed: how the five paths the daemons write came out. */
+	opi5plus_report_perms();
+	return 0;
+}
+
+/*
+ * What launchd will actually see. The Data seed of this port is an empty APFS container (nothing on Linux can
+ * write into APFS), so the directories iPadOS expects under /private/var may simply not be there: this says
+ * which of them resolve, and whether the dyld shared cache is reachable through the SystemOS union.
+ */
+static void
+opi5plus_check_paths(void)
+{
+	static const char *paths[] = {
+		"/private/var/db",
+		"/private/var/vm",
+		"/private/var/mobile",
+		"/private/var/tmp",
+		"/private/var/keybags",
+		"/private/var/preferences",
+		"/private/var/root",
+		"/System/Library/Caches/com.apple.dyld",
+	};
+	vfs_context_t ctx = vfs_context_kernel();
+
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]); ++i) {
+		vnode_t vp = NULLVP;
+		int probe = vnode_lookup(paths[i], 0, &vp, ctx);
+		printf("opi5plus: path %s -> %d\n", paths[i], probe);
+		if (probe == 0 && vp != NULLVP) {
+			vnode_put(vp);
+		}
+	}
+}
+
+/*
+ * The heartbeat and the process table. A userland whose output goes to logd is otherwise a black box: the
+ * exec trace says which program started last, and this says whether it is still there and in which state.
+ *
+ * The heartbeat goes out through PE_kputc, the platform expert's own character output, so it does not take
+ * the BSD console lock. That is the point of it: when the console goes silent, this line still says whether
+ * the kernel is running, which separates "a thread holds the console" from "the machine is stuck".
+ */
+extern struct proclist allproc;
+extern volatile uint64_t native_sd_block_requests;
+extern volatile uint64_t native_sd_block_failures;
+extern volatile uint64_t native_sd_blocks_read;
+
+static void
+opi5plus_pe_char(char c)
+{
+	extern void (*PE_kputc)(char);
+	if (PE_kputc) {
+		PE_kputc(c);
+	}
+}
+
+static void
+opi5plus_pe_puts(const char *text)
+{
+	while (*text) {
+		opi5plus_pe_char(*text++);
+	}
+}
+
+static void
+opi5plus_pe_number(unsigned long long value)
+{
+	char digits[24];
+	int count = 0;
+
+	if (value == 0) {
+		opi5plus_pe_char('0');
+		return;
+	}
+	while (value != 0 && count < (int)sizeof(digits)) {
+		digits[count++] = (char)('0' + (value % 10));
+		value /= 10;
+	}
+	while (count > 0) {
+		opi5plus_pe_char(digits[--count]);
+	}
+}
+
+static void
+opi5plus_ps_thread(void *arg, wait_result_t wret)
+{
+	uint32_t interval = 0;
+	uint32_t rebootAfter = 0;
+	uint32_t elapsed = 0;
+
+	(void)PE_parse_boot_argn("sd-ps", &interval, sizeof(interval));
+	/* sd-auto-reboot=N: panic after N seconds so the board goes back to the card by itself (the PSCI
+	 * restart in this port resets on panic). Without it every run leaves the board inside XNU and the next
+	 * payload cannot be pushed. */
+	(void)PE_parse_boot_argn("sd-auto-reboot", &rebootAfter, sizeof(rebootAfter));
+	if (!interval && !rebootAfter) {
+		(void)thread_terminate(current_thread());
+		return;
+	}
+	while (1) {
+		(void)tsleep(&allproc, PUSER, "opi5ps", (int)(5 * hz));
+		elapsed += 5;
+		opi5plus_pe_puts("\r\nopi5plus beat ");
+		opi5plus_pe_number(elapsed);
+		opi5plus_pe_puts(" s, requests ");
+		opi5plus_pe_number(native_sd_block_requests);
+		opi5plus_pe_puts(", blocks ");
+		opi5plus_pe_number(native_sd_blocks_read);
+		opi5plus_pe_puts(", failures ");
+		opi5plus_pe_number(native_sd_block_failures);
+		/* How many processes are alive, so a launchd that exits is visible even when the console is not. */
+		{
+			unsigned live = 0;
+			proc_t walk;
+			for (walk = allproc.lh_first; walk != 0; walk = walk->p_list.le_next) {
+				live++;
+			}
+			opi5plus_pe_puts(", procs ");
+			opi5plus_pe_number(live);
+		}
+		/* The display probe's last step, so a boot that stops before launchd still says where it stopped. */
+		opi5plus_pe_puts(", stage ");
+		opi5plus_pe_number(opi5plus_probe_stage());
+		opi5plus_pe_puts(" (");
+		opi5plus_pe_puts(opi5plus_probe_stage_name());
+		opi5plus_pe_puts(")");
+		/*
+		 * Memory headroom and what is left on the Data volume, on the line the beat already writes: a boot that
+		 * runs out of pages and a boot that fills /private/var with logs look the same from the outside otherwise.
+		 * vfs_statfs() answers from the mount's cached statistics -- no lock and no call into the file system;
+		 * vfs_update_vfsstat() would send VFS_STATFS down and can block.
+		 */
+		{
+			struct vfsstatfs *statfs = NULL;
+			mount_t data = opi5plus_data_mount;
+			unsigned long long vfree_pages = 0;
+			unsigned long long vspec_pages = 0;
+			unsigned long long vcomp_pages = 0;
+
+			opi5plus_vm_page_counts(&vfree_pages, &vspec_pages, &vcomp_pages);
+			opi5plus_pe_puts(", vfree ");
+			opi5plus_pe_number(vfree_pages);
+			opi5plus_pe_puts(", vspec ");
+			opi5plus_pe_number(vspec_pages);
+			opi5plus_pe_puts(", vcomp ");
+			opi5plus_pe_number(vcomp_pages);
+			if (data != NULL && !vfs_isunmount(data)) {
+				statfs = vfs_statfs(data);
+			}
+			opi5plus_pe_puts(", dbavail ");
+			if (statfs == NULL) {
+				opi5plus_pe_puts("-1");
+			} else {
+				opi5plus_pe_number((unsigned long long)statfs->f_bavail);
+			}
+		}
+		opi5plus_pe_puts("\r\n");
+		/* Process exits since the last beat: the ring is filled from every exit_with_reason() and printed
+		 * here, by the thread that already writes the beat line straight to the UART. It sits after the
+		 * watchdog kick on purpose: a printf on this console can block while logd floods it with ENOSPC
+		 * lines, and a wedged beat thread would also stop the auto-reboot timer (measured: the board
+		 * stayed in XNU past sd-auto-reboot when this call was a printf placed before the kick). */
+		native_sd_watchdog_kick();
+		opi5plus_report_exits();
+		if (interval != 0 && (elapsed % interval) == 0) {
+			printf("opi5plus: sd io %llu requests %llu blocks %llu failures, uptime %u s\n",
+			    (unsigned long long)native_sd_block_requests,
+			    (unsigned long long)native_sd_blocks_read,
+			    (unsigned long long)native_sd_block_failures, elapsed);
+			proc_t scan;
+			for (scan = allproc.lh_first; scan != 0; scan = scan->p_list.le_next) {
+				printf("opi5plus: ps %d(%s) stat %d flag %#x ppid %d\n", proc_getpid(scan),
+				    scan->p_comm, (int)scan->p_stat, scan->p_flag, scan->p_ppid);
+			}
+		}
+		if (rebootAfter != 0 && elapsed >= rebootAfter) {
+			/*
+			 * A panic resets this board (the port's PSCI restart). Stop-kicking-the-watchdog was the original
+			 * form and it is strictly worse: it only resets if the watchdog was armed, and on 2026-11-08 a
+			 * run reached this branch with no "watchdog armed" line at all and stayed in the kernel for
+			 * half an hour, which costs a manual power cycle. The panic string goes out through the hook in
+			 * osfmk/kern/debug.c, which writes the UART directly, so a held console does not swallow it.
+			 */
+			opi5plus_pe_puts("\r\nopi5plus: sd-auto-reboot, resetting\r\n");
+			panic("opi5plus: sd-auto-reboot after %u s", elapsed);
+		}
+	}
+}
+
+void
+opi5plus_start_ps_thread(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(opi5plus_ps_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
