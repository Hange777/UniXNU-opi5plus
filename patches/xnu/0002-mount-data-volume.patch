+/*
+ * The firmware's GOP frame buffer, read out of the loader's own handoff line:
+ *   DARWINBOOT: video base=0xE6760000 display=1 row=10240 width=2560 height=1440 depth=32
+ * Nothing in this port drives it yet, so the screen keeps the loader's last frame. sd-paint=1 fills it once,
+ * which is the cheapest possible proof that the kernel can reach it -- and the first thing an IOFramebuffer
+ * needs to know.
+ */
+static void
+opi5plus_paint_screen(void)
+{
+	const uint64_t base = 0xE6760000ull;
+	const uint64_t width = 2560;
+	const uint64_t rowBytes = 10240;
+	const uint64_t height = 1440;
+	const uint64_t total = rowBytes * height;
+	/* One 14 MiB mapping does not fit -- ml_io_map failed in kmem_alloc with KERN_NO_SPACE -- so the screen is
+	 * painted a megabyte at a time, each band mapped, filled and freed before the next one. */
+	const uint64_t chunk = 1ull << 20;
+	extern vm_offset_t ml_io_map(vm_offset_t phys, vm_size_t size);
+	uint64_t painted = 0;
+
+	for (uint64_t offset = 0; offset < total; offset += chunk) {
+		const uint64_t size = (total - offset) < chunk ? (total - offset) : chunk;
+		vm_offset_t mapped = ml_io_map((vm_offset_t)(base + offset), (vm_size_t)size);
+
+		if (mapped == 0) {
+			/* ml_io_map's entries are permanent (vm_map_delete rejects them), so the bands already mapped
+			 * cannot be given back; the paint simply stops where the kernel's mapping space runs out. */
+			break;
+		}
+		{
+			/* Colour bars a third of the screen apart, so the pattern is unmistakable. */
+			const uint64_t phase = (offset * 3) / total;
+			const uint32_t colour = (phase == 0) ? 0x002040C0u : (phase == 1) ? 0x0000C040u : 0x00C04000u;
+			volatile uint32_t *pixels = (volatile uint32_t *)mapped;
+			for (uint64_t word = 0; word < size / 4; ++word) {
+				pixels[word] = colour;
+			}
+		}
+		painted += size;
+	}
+	opi5plus_pe_puts("\r\nopi5plus: framebuffer bands painted, bytes: ");
+	{
+		uint64_t value = painted;
+		char digits[24];
+		int count = 0;
+		if (value == 0) {
+			opi5plus_pe_puts("0");
+		} else {
+			while (value != 0 && count < 24) {
+				digits[count++] = (char)('0' + (value % 10));
+				value /= 10;
+			}
+			while (count > 0) {
+				char text[2] = {digits[--count], 0};
+				opi5plus_pe_puts(text);
+			}
+		}
+	}
+	opi5plus_pe_puts("\r\n");
+	(void)width;
+	(void)rowBytes;
+}
