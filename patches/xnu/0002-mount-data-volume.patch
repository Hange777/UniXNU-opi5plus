+/*
+ * The first-boot seed of the Data volume.
+ *
+ * The Data volume of this port is an empty APFS container, while the OS volume carries the
+ * /private/var tree a first boot expects and the preference plists that skip the Setup assistant.
+ * UniXNU-evb10 does exactly this for its own Data volume (evb10-userland-mounts.patch,
+ * evb10_data_copy and evb10_seed_prefs_write), and its board reaches SpringBoard with it; without
+ * the plists the board is put to sleep ~30 s after SpringBoard starts (IOPMrootDomain ->
+ * IOCPUSleepKernel -> ArmCpu::haltCPU), which is the state this port stops in after "swap ok".
+ *
+ * The tree is copied from the directory the Data mount covers (mount->mnt_vnodecovered, the OS
+ * volume's /private/var): directories, regular files through the OS volume's decmpfs and symbolic
+ * links, with the mode and the owner of the source. The walk is iterative because APFS operations
+ * need much of the kernel stack, and staged_system_apps is left out, as in the official seed.
+ *
+ * sd-data-seed=0 turns it off. /private/var/.opi5plus-seeded, written on a persistent Data volume
+ * only after a boot copied the tree without a single failure, makes the next boot skip the copy; on
+ * the RAM Data volume (sd-data-ram=1) the marker cannot survive a reset, so every boot seeds again.
+ */
+#define OPI5PLUS_SEED_MARKER "/private/var/.opi5plus-seeded"
+#define OPI5PLUS_SEED_CHUNK (512 * 1024)
+#define OPI5PLUS_SEED_ENTRIES 8192
+#define OPI5PLUS_SEED_POOL (1024 * 1024)
+#define OPI5PLUS_SEED_DIRS 8192
+/* Scratch page offsets: the mount arguments end below 0x400 (opi5plus_apfs_mount), a path is a
+ * MAXPATHLEN each, and the page is 4 KiB. */
+#define OPI5PLUS_SEED_PATH (0x400)
+#define OPI5PLUS_SEED_LINK (0x800)
+#define OPI5PLUS_SEED_UNLINK (0xc00)
+
+struct opi5plus_seed {
+	proc_t p;
+	user_addr_t scratch;
+	vfs_context_t ctx;
+	vnode_t root;              /* the OS volume's /private/var, iocount held by the caller */
+	size_t base;               /* strlen("/private/var") */
+	uint8_t *chunk;            /* one file's worth of bytes */
+	uint8_t *entries;          /* one directory read */
+	char *pool;                /* directories still to copy, relative to root */
+	uint32_t *at;
+	uint32_t used;
+	uint32_t count;
+	uint64_t bytes;
+	int dirs;
+	int files;
+	int links;
+	int other;
+	int skipped;
+	int failed;
+	int error;
+};
+
+static void
+opi5plus_seed_fail(struct opi5plus_seed *seed, const char *path, const char *what, int error)
+{
+	seed->failed++;
+	seed->error = error;
+	if (seed->failed <= 40) {
+		printf("opi5plus: seed: %s %s failed: %d\n", what, path, error);
+	}
+}
+
+static void
+opi5plus_seed_attrs_of(vnode_t vp, vfs_context_t ctx, struct opi5plus_seed_attrs *attrs, mode_t fallback)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	attrs->mode = fallback;
+	attrs->uid = 0;
+	attrs->gid = 0;
+	if (vnode_getattr(vp, &va, ctx) == 0) {
+		if (VATTR_IS_SUPPORTED(&va, va_mode)) {
+			attrs->mode = va.va_mode & 07777;
+		}
+		if (VATTR_IS_SUPPORTED(&va, va_uid)) {
+			attrs->uid = va.va_uid;
+		}
+		if (VATTR_IS_SUPPORTED(&va, va_gid)) {
+			attrs->gid = va.va_gid;
+		}
+	}
+}
+
+static int
+opi5plus_seed_attrs_set(vnode_t vp, vfs_context_t ctx, const struct opi5plus_seed_attrs *attrs, int link)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, attrs->uid);
+	VATTR_SET(&va, va_gid, attrs->gid);
+	if (!link) {
+		VATTR_SET(&va, va_mode, attrs->mode);
+	}
+	return vnode_setattr(vp, &va, ctx);
+}
+
+static int
+opi5plus_seed_mkdir(struct opi5plus_seed *seed, const char *path, const struct opi5plus_seed_attrs *attrs)
+{
+	struct mkdir_args request = {.path = seed->scratch + OPI5PLUS_SEED_PATH, .mode = 0755};
+	int32_t result = 0;
+	vnode_t vp = NULLVP;
+	int error = copyout(path, request.path, strlen(path) + 1);
+
+	if (error == 0) {
+		error = mkdir(seed->p, &request, &result);
+	}
+	if (error != 0 && error != EEXIST) {
+		return error;
+	}
+	error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, seed->ctx);
+	if (error == 0) {
+		error = opi5plus_seed_attrs_set(vp, seed->ctx, attrs, 0);
+		vnode_put(vp);
+	}
+	return error;
+}
+
+static int
+opi5plus_seed_ensure_dir(struct opi5plus_seed *seed, const char *path, mode_t mode, uid_t uid, gid_t gid)
+{
+	struct opi5plus_seed_attrs attrs = {.mode = mode, .uid = uid, .gid = gid};
+	vnode_t vp = NULLVP;
+	int error = opi5plus_seed_mkdir(seed, path, &attrs);
+
+	/*
+	 * The owner is set whether this call made the directory or found it: a directory that already exists is
+	 * exactly the case that has to be repaired, and the early return that used to be here is why the first
+	 * seed of a persistent Data volume left /private/var/mobile/tmp to root.
+	 */
+	if (error != 0) {
+		return error;
+	}
+	error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, seed->ctx);
+	if (error == 0) {
+		error = opi5plus_seed_attrs_set(vp, seed->ctx, &attrs, 0);
+		vnode_put(vp);
+	}
+	return error;
+}
+
+/* A file of exactly these bytes (O_TRUNC), with this owner and mode, and on the medium before it returns. */
+static int
+opi5plus_seed_write(struct opi5plus_seed *seed, const char *path, const void *data, size_t size, mode_t mode,
+    uid_t uid, gid_t gid)
+{
+	vfs_context_t ctx = seed->ctx;
+	vnode_t vp = NULLVP;
+	off_t done = 0;
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, mode, 0, &vp, ctx);
+
+	if (error != 0) {
+		return error;
+	}
+	while (error == 0 && (size_t)done < size) {
+		size_t piece = size - (size_t)done;
+		int resid = 0;
+
+		if (piece > (size_t)(1024 * 1024)) {
+			piece = 1024 * 1024;
+		}
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)((uintptr_t)data + (uintptr_t)done), (int)piece, done,
+		    UIO_SYSSPACE, IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+		done += (off_t)piece;
+	}
+	if (error == 0) {
+		struct opi5plus_seed_attrs attrs = {.mode = mode, .uid = uid, .gid = gid};
+		error = opi5plus_seed_attrs_set(vp, ctx, &attrs, 0);
+	}
+	if (error == 0) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	{
+		int close_error = vnode_close(vp, FWRITE, ctx);
+		if (error == 0) {
+			error = close_error;
+		}
+	}
+	return error;
+}
+
+/* Reads to the end of the source rather than trusting its size: most of these files are compressed on
+ * the OS volume. */
+static int
+opi5plus_seed_copy_file(struct opi5plus_seed *seed, vnode_t source, const char *path,
+    const struct opi5plus_seed_attrs *attrs)
+{
+	vfs_context_t ctx = seed->ctx;
+	vnode_t vp = NULLVP;
+	off_t at = 0;
+	int error = VNOP_OPEN(source, FREAD, ctx);
+
+	if (error != 0) {
+		return error;
+	}
+	error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, attrs->mode & 0777, 0, &vp, ctx);
+	while (error == 0) {
+		int resid = 0;
+		int length;
+
+		error = vn_rdwr(UIO_READ, source, (caddr_t)seed->chunk, OPI5PLUS_SEED_CHUNK, at, UIO_SYSSPACE,
+		    IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		length = OPI5PLUS_SEED_CHUNK - resid;
+		if (error != 0 || length <= 0) {
+			break;
+		}
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)seed->chunk, length, at, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+		at += length;
+		seed->bytes += (uint64_t)length;
+	}
+	if (vp != NULLVP) {
+		if (error == 0) {
+			error = opi5plus_seed_attrs_set(vp, ctx, attrs, 0);
+		}
+		/* Each file reaches the medium before the next one: without this the copy piles up dirty pages
+		 * until it stalls. */
+		if (error == 0) {
+			error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		}
+		{
+			int close_error = vnode_close(vp, FWRITE, ctx);
+			if (error == 0) {
+				error = close_error;
+			}
+		}
+	}
+	VNOP_CLOSE(source, FREAD, ctx);
+	return error;
+}
+
+static int
+opi5plus_seed_copy_link(struct opi5plus_seed *seed, vnode_t source, const char *path,
+    const struct opi5plus_seed_attrs *attrs)
+{
+	/* syscalls.master declares symlink(char *path, char *link): path is the target text, link the new name.
+	 * The stub takes both as user addresses (generated sysproto.h: user_addr_t), so they are handed over as
+	 * the addresses they already are. */
+	const user_addr_t target_addr = seed->scratch + OPI5PLUS_SEED_PATH;
+	const user_addr_t link_addr = seed->scratch + OPI5PLUS_SEED_LINK;
+	struct symlink_args request = {.path = target_addr, .link = link_addr};
+	char *target = (char *)seed->chunk;
+	int32_t result = 0;
+	vnode_t vp = NULLVP;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	size_t length;
+	int error;
+
+	if (uio == NULL) {
+		return ENOMEM;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(target), MAXPATHLEN - 1);
+	error = VNOP_READLINK(source, uio, seed->ctx);
+	length = (size_t)(MAXPATHLEN - 1) - (size_t)uio_resid(uio);
+	uio_free(uio);
+	if (error != 0) {
+		return error;
+	}
+	if (length == 0 || length >= (size_t)(MAXPATHLEN - 1)) {
+		return EIO;
+	}
+	target[length] = '\0';
+	if ((error = copyout(target, target_addr, length + 1)) != 0 ||
+	    (error = copyout(path, link_addr, strlen(path) + 1)) != 0) {
+		return error;
+	}
+	error = symlink(seed->p, &request, &result);
+	if (error != 0 && error != EEXIST) {
+		return error;
+	}
+	error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, seed->ctx);
+	if (error == 0) {
+		error = opi5plus_seed_attrs_set(vp, seed->ctx, attrs, 1);
+		vnode_put(vp);
+	}
+	return error;
+}
+
+/*
+ * Copies the entries of DIR into the seed's PATH (appending each name to PATH and cutting it off
+ * again) and queues its subdirectories, whose source-relative paths start at REL inside PATH.
+ */
+static void
+opi5plus_seed_copy_dir(struct opi5plus_seed *seed, vnode_t dir, char *path, size_t path_size, size_t rel)
+{
+	vfs_context_t ctx = seed->ctx;
+	size_t base = strlen(path);
+	off_t offset = 0;
+	int eof = 0;
+	int error = VNOP_OPEN(dir, FREAD, ctx);
+
+	if (error != 0) {
+		opi5plus_seed_fail(seed, path, "open of", error);
+		return;
+	}
+	while (error == 0 && !eof) {
+		uio_t uio = uio_create(1, offset, UIO_SYSSPACE, UIO_READ);
+		int count = 0;
+		uint32_t filled;
+
+		if (uio == NULL) {
+			error = ENOMEM;
+			break;
+		}
+		uio_addiov(uio, CAST_USER_ADDR_T(seed->entries), OPI5PLUS_SEED_ENTRIES);
+		error = vnode_readdir64(dir, uio, VNODE_READDIR_EXTENDED, &eof, &count, ctx);
+		filled = (uint32_t)(OPI5PLUS_SEED_ENTRIES - (uint32_t)uio_resid(uio));
+		offset = uio_offset(uio);
+		uio_free(uio);
+		if (error != 0 || filled == 0) {
+			break;
+		}
+		for (uint32_t at = 0; at + offsetof(struct direntry, d_name) < filled;) {
+			struct direntry *entry = (struct direntry *)(seed->entries + at);
+			const char *name;
+			vnode_t child = NULLVP;
+			int child_error;
+
+			if (entry->d_reclen == 0 || at + entry->d_reclen > filled) {
+				error = EINVAL;
+				break;
+			}
+			at += entry->d_reclen;
+			name = entry->d_name;
+			if (entry->d_ino == 0 || !strcmp(name, ".") || !strcmp(name, "..")) {
+				continue;
+			}
+			/* The official seed leaves the staged system apps out (tens of megabytes). */
+			if (base == seed->base && !strcmp(name, "staged_system_apps")) {
+				seed->skipped++;
+				continue;
+			}
+			if (base + 1 + strlen(name) >= path_size) {
+				opi5plus_seed_fail(seed, name, "name too long:", ENAMETOOLONG);
+				continue;
+			}
+			path[base] = '/';
+			strlcpy(path + base + 1, name, path_size - base - 1);
+			child_error = vnode_lookupat(name, VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT, &child,
+			    ctx, dir);
+			if (child_error == 0) {
+				struct opi5plus_seed_attrs attrs;
+				enum vtype type = vnode_vtype(child);
+
+				opi5plus_seed_attrs_of(child, ctx, &attrs, type == VDIR ? 0755 : 0644);
+				if (type == VDIR) {
+					size_t length;
+					child_error = opi5plus_seed_mkdir(seed, path, &attrs);
+					length = strlen(path + rel) + 1;
+					if (child_error == 0 &&
+					    (seed->count == OPI5PLUS_SEED_DIRS || OPI5PLUS_SEED_POOL - seed->used < length)) {
+						child_error = ENOSPC;
+					}
+					if (child_error == 0) {
+						memcpy(seed->pool + seed->used, path + rel, length);
+						seed->at[seed->count++] = seed->used;
+						seed->used += (uint32_t)length;
+						seed->dirs++;
+					}
+				} else if (type == VREG) {
+					child_error = opi5plus_seed_copy_file(seed, child, path, &attrs);
+					if (child_error == 0) {
+						seed->files++;
+					}
+				} else if (type == VLNK) {
+					child_error = opi5plus_seed_copy_link(seed, child, path, &attrs);
+					if (child_error == 0) {
+						seed->links++;
+					}
+				} else {
+					seed->other++;
+					printf("opi5plus: seed: %s is neither a directory, a file nor a link (type %d), left out\n",
+					    path, (int)type);
+				}
+				vnode_put(child);
+			}
+			if (child_error != 0) {
+				opi5plus_seed_fail(seed, path, "copy of", child_error);
+			}
+			path[base] = '\0';
+		}
+	}
+	if (error != 0) {
+		opi5plus_seed_fail(seed, path, "reading", error);
+	}
+	VNOP_CLOSE(dir, FREAD, ctx);
+}
+
+/* Copies the tree below seed->root into the Data directory PATH, which exists. */
+static void
+opi5plus_seed_walk(struct opi5plus_seed *seed, char *path, size_t path_size)
+{
+	size_t root = strlen(path);
+
+	opi5plus_seed_copy_dir(seed, seed->root, path, path_size, root + 1);
+	while (seed->count != 0) {
+		const char *rel = seed->pool + seed->at[--seed->count];
+		vnode_t dir = NULLVP;
+		int error;
+
+		if (root + 1 + strlen(rel) >= path_size) {
+			opi5plus_seed_fail(seed, rel, "name too long:", ENAMETOOLONG);
+			continue;
+		}
+		path[root] = '/';
+		strlcpy(path + root + 1, rel, path_size - root - 1);
+		error = vnode_lookupat(rel, VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT, &dir, seed->ctx,
+		    seed->root);
+		if (error == 0) {
+			opi5plus_seed_copy_dir(seed, dir, path, path_size, root + 1);
+			vnode_put(dir);
+		} else {
+			opi5plus_seed_fail(seed, path, "lookup of", error);
+		}
+		path[root] = '\0';
+	}
+}
+
+/*
+ * The preference plists that skip the Setup assistant and keep the display on, byte for byte the ones
+ * UniXNU's scripts/seed-data-skip-setup.py (--no-auto-dim) writes into a Data seed on macOS, and the
+ * ones evb10-userland-mounts.patch writes from the kernel (evb10_seed_prefs[]). XML property lists:
+ * CFPreferences reads both forms. evb10-seed-prefs=0 turns it off there, sd-data-seed=0 here.
+ */
+#define OPI5PLUS_PL_HEAD "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" \
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n" \
+	"<plist version=\"1.0\">\n<dict>\n"
+#define OPI5PLUS_PL_TAIL "</dict>\n</plist>\n"
+#define OPI5PLUS_PL_TRUE(k) "\t<key>" k "</key>\n\t<true/>\n"
+#define OPI5PLUS_PL_FALSE(k) "\t<key>" k "</key>\n\t<false/>\n"
+
+static const struct {
+	const char *name;
+	const char *body;
+} opi5plus_seed_prefs[] = {
+	{"com.apple.purplebuddy",
+	 OPI5PLUS_PL_HEAD OPI5PLUS_PL_TRUE("SetupDone") OPI5PLUS_PL_TRUE("SetupFinishedAllSteps")
+	 "\t<key>SetupVersion</key>\n\t<integer>11</integer>\n" OPI5PLUS_PL_FALSE("daemonizeNeedsToRun") OPI5PLUS_PL_TAIL},
+	{"com.apple.purplebuddy.notbackedup",
+	 OPI5PLUS_PL_HEAD OPI5PLUS_PL_FALSE("ShouldRunDiagnosticsMiniBuddy") OPI5PLUS_PL_FALSE("ShouldRunHSA2MiniBuddy")
+	 OPI5PLUS_PL_FALSE("ShouldRunKeychainSyncMiniBuddy") OPI5PLUS_PL_FALSE("ShouldRunMesaMiniBuddy")
+	 OPI5PLUS_PL_FALSE("ShouldRunPaymentMiniBuddy") OPI5PLUS_PL_FALSE("ShouldRunStandardMiniBuddy")
+	 OPI5PLUS_PL_FALSE("SilentICDPUpgrade") OPI5PLUS_PL_TAIL},
+	{"com.apple.managedconfiguration.notbackedup",
+	 OPI5PLUS_PL_HEAD OPI5PLUS_PL_FALSE("LockdownActivationIndicatesCloudConfigurationAvailable") OPI5PLUS_PL_TAIL},
+	{"com.apple.springboard",
+	 OPI5PLUS_PL_HEAD OPI5PLUS_PL_TRUE("BKNoWatchdogs")
+	 "\t<key>FBLaunchWatchdogExceptions</key>\n\t<dict>\n\t\t<key>com.apple.purplebuddy</key>\n\t\t<real>100</real>\n\t</dict>\n"
+	 OPI5PLUS_PL_FALSE("MCForceShowCloudConfigurationUI")
+	 OPI5PLUS_PL_TRUE("SBDisableAutoDim") OPI5PLUS_PL_TRUE("SBDontDimOrLockOnAC") OPI5PLUS_PL_TRUE("SBDisableIdleSleep")
+	 OPI5PLUS_PL_TAIL},
+	{"com.apple.migration",
+	 OPI5PLUS_PL_HEAD "\t<key>LastSystemVersion</key>\n\t<string>21H461</string>\n"
+	 "\t<key>DMUserDataDisposition</key>\n\t<dict>\n\t\t<key>SyntheticDidUpgrade</key>\n\t\t<false/>\n"
+	 "\t\t<key>buildVersion</key>\n\t\t<string>21H461</string>\n\t</dict>\n" OPI5PLUS_PL_TAIL},
+};
+
+static void
+opi5plus_seed_prefs_write(struct opi5plus_seed *seed)
+{
+	static const struct {
+		const char *path;
+		mode_t mode;
+		uid_t uid;
+		gid_t gid;
+	} dirs[] = {
+		{"/private/var/mobile/Library", 0755, 501, 501},
+		{"/private/var/mobile/Library/Preferences", 0755, 501, 501},
+		/* On a device these live on the data volume (UniXNU's seed tool and ios-sweet's root tweaks make them too). */
+		{"/private/var/containers", 0755, 0, 0},
+		{"/private/var/containers/Bundle", 0755, 0, 0},
+		{"/private/var/containers/Data", 0755, 0, 0},
+		{"/private/var/containers/Data/System", 0755, 0, 0},
+		{"/private/var/containers/Shared", 0755, 0, 0},
+		{"/private/var/containers/Shared/SystemGroup", 0755, 0, 0},
+		{"/private/var/containers/Temp", 0755, 0, 0},
+	};
+	char *path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+
+	for (unsigned i = 0; i < sizeof(dirs) / sizeof(dirs[0]); ++i) {
+		const int error = opi5plus_seed_ensure_dir(seed, dirs[i].path, dirs[i].mode, dirs[i].uid, dirs[i].gid);
+
+		if (error != 0) {
+			opi5plus_seed_fail(seed, dirs[i].path, "creating", error);
+		}
+	}
+	if (path == NULL) {
+		opi5plus_seed_fail(seed, "preferences", "memory for", ENOMEM);
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(opi5plus_seed_prefs) / sizeof(opi5plus_seed_prefs[0]); ++i) {
+		int error;
+
+		snprintf(path, MAXPATHLEN, "/private/var/mobile/Library/Preferences/%s.plist", opi5plus_seed_prefs[i].name);
+		error = opi5plus_seed_write(seed, path, opi5plus_seed_prefs[i].body, strlen(opi5plus_seed_prefs[i].body), 0600,
+		    501, 501);
+		if (error != 0) {
+			opi5plus_seed_fail(seed, path, "writing", error);
+		}
+	}
+	kfree_data(path, MAXPATHLEN);
+	printf("opi5plus: seed: wrote %d preference files (Setup skipped, auto dim and idle sleep off)\n",
+	    (int)(sizeof(opi5plus_seed_prefs) / sizeof(opi5plus_seed_prefs[0])));
+}
+
+/* Written on a persistent Data volume after the first complete copy; present = the tree is there. */
+static int
+opi5plus_seed_marker_present(vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(OPI5PLUS_SEED_MARKER, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) != 0) {
+		return 0;
+	}
+	vnode_put(vp);
+	return 1;
+}
+
+/*
+ * The seed itself, called once the Data volume is mounted on /private/var: copy the OS volume's
+ * /private/var tree in, make the directories the first boot writes into, write the five preference
+ * plists, and mark a persistent volume as seeded.
+ */
+static void
+opi5plus_seed_tree(proc_t p, user_addr_t scratch, mount_t data_mount)
+{
+	struct opi5plus_seed seed = {.p = p, .scratch = scratch, .ctx = vfs_context_kernel(),
+	    .base = sizeof("/private/var") - 1};
+	uint32_t persist = 0;
+	int persistent;
+	vnode_t covered;
+	char *path;
+	int error;
+
+	(void) PE_parse_boot_argn("sd-data-persist", &persist, sizeof(persist));
+	/*
+	 * package/NativeSd formats a window at the end of userdata when sd-data-persist=1 and publishes the
+	 * payload's Data seed as a RAM block device only if that failed, which is also why the payload script
+	 * passes both. The marker is worth reading only on the card window, so sd-data-persist is what says
+	 * whether to look for it; a RAM volume is empty again after every reset, so a marker written there
+	 * (the format failed) cannot make the next boot skip the copy.
+	 */
+	persistent = (persist != 0);
+	if (persistent && opi5plus_seed_marker_present(seed.ctx)) {
+		printf("opi5plus: seed: persistent Data volume, seeded by an earlier boot (%s exists): nothing copied\n",
+		    OPI5PLUS_SEED_MARKER);
+		return;
+	}
+	covered = data_mount->mnt_vnodecovered;
+	error = (covered != NULLVP) ? vnode_getwithref(covered) : ENOENT;
+	path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	seed.chunk = kalloc_data(OPI5PLUS_SEED_CHUNK, Z_WAITOK);
+	seed.entries = kalloc_data(OPI5PLUS_SEED_ENTRIES, Z_WAITOK);
+	seed.pool = kalloc_data(OPI5PLUS_SEED_POOL, Z_WAITOK);
+	seed.at = kalloc_data(OPI5PLUS_SEED_DIRS * sizeof(uint32_t), Z_WAITOK);
+	if (error != 0) {
+		printf("opi5plus: seed: the OS volume's /private/var under the mount is not reachable: %d\n", error);
+		opi5plus_seed_fail(&seed, "/private/var", "the OS volume's", error);
+	} else if (path == NULL || seed.chunk == NULL || seed.entries == NULL || seed.pool == NULL || seed.at == NULL) {
+		printf("opi5plus: seed: out of memory for the copy\n");
+		opi5plus_seed_fail(&seed, "/private/var", "memory for", ENOMEM);
+	} else {
+		/* The runtime directories of the official seed: the OS tree does not have them. */
+		static const struct {
+			const char *path;
+			mode_t mode;
+			uid_t uid;
+			gid_t gid;
+		} runtime[] = {
+			{"/private/var/keybags", 0755, 0, 0},
+			{"/private/var/mobile", 0755, 501, 501},
+			{"/private/var/mobile/tmp", 0755, 501, 501},
+			{"/private/var/tmp", 01777, 0, 0},
+			{"/private/var/run", 0755, 0, 0},
+		};
+		struct opi5plus_seed_attrs top;
+
+		seed.root = covered;
+		opi5plus_seed_attrs_of(covered, seed.ctx, &top, 0755);
+		strlcpy(path, "/private/var", MAXPATHLEN);
+		error = opi5plus_seed_mkdir(&seed, path, &top);
+		if (error != 0) {
+			opi5plus_seed_fail(&seed, path, "attributes of", error);
+		}
+		opi5plus_seed_walk(&seed, path, MAXPATHLEN);
+		for (unsigned i = 0; i < sizeof(runtime) / sizeof(runtime[0]); ++i) {
+			error = opi5plus_seed_ensure_dir(&seed, runtime[i].path, runtime[i].mode, runtime[i].uid,
+			    runtime[i].gid);
+			if (error != 0) {
+				opi5plus_seed_fail(&seed, runtime[i].path, "creating", error);
+			}
+		}
+		opi5plus_seed_prefs_write(&seed);
+	}
+	if (error == 0 && covered != NULLVP) {
+		vnode_put(covered);
+	}
+	if (path != NULL) {
+		kfree_data(path, MAXPATHLEN);
+	}
+	if (seed.chunk != NULL) {
+		kfree_data(seed.chunk, OPI5PLUS_SEED_CHUNK);
+	}
+	if (seed.entries != NULL) {
+		kfree_data(seed.entries, OPI5PLUS_SEED_ENTRIES);
+	}
+	if (seed.pool != NULL) {
+		kfree_data(seed.pool, OPI5PLUS_SEED_POOL);
+	}
+	if (seed.at != NULL) {
+		kfree_data(seed.at, OPI5PLUS_SEED_DIRS * sizeof(uint32_t));
+	}
+	printf("opi5plus: seed: tree copied: %d directories, %d files (%d KiB), %d links, %d left out, %d skipped, %d failures (last error %d)\n",
+	    seed.dirs, seed.files, (int)(seed.bytes >> 10), seed.links, seed.other, seed.skipped, seed.failed, seed.error);
+	if (!persistent) {
+		printf("opi5plus: seed: RAM Data volume, no marker: the next boot seeds again\n");
+	} else if (seed.failed != 0) {
+		printf("opi5plus: seed: %d failures: the volume is not marked as seeded, the next boot copies again\n",
+		    seed.failed);
+	} else {
+		static const char marker_text[] = "seeded by 0002-mount-data-volume\n";
+
+		/* Everything above is on the card before the marker says so. */
+		error = VFS_SYNC(data_mount, MNT_WAIT, seed.ctx);
+		if (error == 0) {
+			error = opi5plus_seed_write(&seed, OPI5PLUS_SEED_MARKER, marker_text, sizeof(marker_text) - 1,
+			    0644, 0, 0);
+		}
+		if (error == 0) {
+			error = VFS_SYNC(data_mount, MNT_WAIT, seed.ctx);
+		}
+		printf("opi5plus: seed: persistent volume marked as seeded (%s): %d\n", OPI5PLUS_SEED_MARKER, error);
+	}
+}
+
+/*
+ * MobileGestalt's caches, dropped on every boot, as UniXNU-evb10 does after its own Data mount
+ * verification (evb10-userland-mounts.patch).
+ *
+ * A Data volume that first saw the display without unit-scale cached MainScreenScale=0 in
+ * MobileGestalt. SpringBoard then builds FBSDisplayMode with preferredScale=0 (sb14: mode 1072x1904
+ * scale 0) even though /chosen display-scale is 2, and no frame reaches the display. Dropping the
+ * caches makes MobileGestalt read /chosen and the ADT again; the files are rewritten on the next
+ * query. This is not part of the marker: it is the same three paths on every boot.
+ */
+static void
+opi5plus_wipe_mobilegestalt(proc_t p, user_addr_t scratch)
+{
+	static const char *const caches[] = {
+		"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.MobileGestalt.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.mobilegestalt.plist",
+	};
+
+	for (unsigned i = 0; i < sizeof(caches) / sizeof(caches[0]); ++i) {
+		struct unlink_args request = {.path = scratch + OPI5PLUS_SEED_UNLINK};
+		int32_t result = 0;
+		int error = copyout(caches[i], request.path, strlen(caches[i]) + 1);
+
+		if (error == 0) {
+			error = unlink(p, &request, &result);
+		}
+		printf("opi5plus: MG cache wiped %s -> %d\n", caches[i], error);
+	}
+}
+
+__attribute__((weak)) int
+native_emmc_root_trusted(int32_t dev)
+{
+	(void)dev;
+	return 0;
+}
