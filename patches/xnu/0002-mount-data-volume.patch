+/*
+ * The mode, the owner and the group of one directory of the skeleton. A mode alone is not enough: the Data
+ * volume is persistent, so from the second boot on the directories are already there, and a directory that the
+ * first boot made as root stays root's whatever the table says. Defined here rather than with the Data seed
+ * below, because the skeleton creates its directories before that seed exists and both use the same setter.
+ */
+struct opi5plus_seed_attrs {
+	mode_t mode;
+	uid_t uid;
+	gid_t gid;
+};
+
+/* Defined with the Data seed below, which comes after the skeleton that needs it. */
+static int opi5plus_seed_attrs_set(vnode_t vp, vfs_context_t ctx, const struct opi5plus_seed_attrs *attrs,
+    int link);
+
+/*
+ * The Data volume of this port is an empty APFS container, while a real data seed carries the skeleton the
+ * boot tasks expect -- /private/var/db, the timezone state, the mobile user's directories. launchd's tzinit
+ * boot task exits 2 without them and launchd then panics on purpose. This is the beginning of the EVB10 cure
+ * (copy the OS volume's /private/var into the data volume once); for now it creates the directories the first
+ * boot tasks ask for, which is enough to see whether the tree or something else is what tzinit wants.
+ */
+static int
+opi5plus_mkdir(proc_t p, user_addr_t scratch, const char *path, int mode, uid_t uid, gid_t gid)
+{
+	struct mkdir_args request = {.path = scratch, .mode = mode};
+	struct opi5plus_seed_attrs attrs = {.mode = (mode_t)mode, .uid = uid, .gid = gid};
+	vnode_t vp = NULLVP;
+	int32_t result = 0;
+	int error = copyout(path, request.path, strlen(path) + 1);
+	vfs_context_t ctx = vfs_context_kernel();
+
+	if (error != 0) {
+		return error;
+	}
+	error = mkdir(p, &request, &result);
+	/*
+	 * EEXIST carries on instead of returning: the directory is there from an earlier boot of the persistent
+	 * Data volume, and its owner still has to be set. This is the round 1 failure -- ensure_dirs found
+	 * /private/var/mobile/tmp present, returned, and left it root's, so mobile (501) could not mkdir in it.
+	 */
+	if (error != 0 && error != EEXIST) {
+		return error;
+	}
+	error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = opi5plus_seed_attrs_set(vp, ctx, &attrs, 0);
+	vnode_put(vp);
+	return error;
+}
