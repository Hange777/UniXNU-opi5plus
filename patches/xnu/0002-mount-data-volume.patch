+#if DEVELOPMENT || DEBUG
+int
+opi5plus_trace_exec(proc_t p, struct execve_args *uap)
+{
+	static int enabled = -1;
+	char name[96];
+	size_t length = 0;
+
+	if (enabled < 0) {
+		uint32_t value = 0;
+		(void) PE_parse_boot_argn("sd-exec", &value, sizeof(value));
+		enabled = value != 0;
+	}
+	if (!enabled || !uap) {
+		return 0;
+	}
+	if (copyinstr(uap->fname, name, sizeof(name), &length) != 0 || !length) {
+		return 0;
+	}
+	/* Straight to the UART: by the time the userland is starting programs, the console is usually held by a
+	 * thread that is waiting for the card, and a printf here would never appear. */
+	opi5plus_pe_puts("\r\nopi5plus: exec ");
+	opi5plus_pe_number(proc_getpid(p));
+	opi5plus_pe_puts(" ");
+	opi5plus_pe_puts(name);
+	opi5plus_pe_puts("\r\n");
+	return 0;
+}
+#endif /* DEVELOPMENT || DEBUG */
+
+#if DEVELOPMENT || DEBUG
+#define OPI5PLUS_EXIT_RING 192
+struct opi5plus_exit_event {
+	char name[24];
+	int pid;
+	int rv;
+	/* p_start.tv_sec: the wall-clock second the process started in (kern_fork.c sets it with
+	 * microtime_with_abstime), so the report can say how long it lived. */
+	long long start;
+};
+static struct opi5plus_exit_event opi5plus_exit_ring[OPI5PLUS_EXIT_RING];
+static volatile uint32_t opi5plus_exit_head, opi5plus_exit_tail;
+static volatile uint32_t opi5plus_exit_total, opi5plus_exit_dropped;
+
+static int
+opi5plus_exit_enabled(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		uint32_t value = 0;
+		(void) PE_parse_boot_argn("sd-exit", &value, sizeof(value));
+		enabled = value != 0;
+	}
+	return enabled;
+}
+
+/* The user backtrace itself belongs to the thread-sample patch (0004); this side only declares it, so a
+ * kernel built without that patch still links. */
+extern void opi5plus_ubt_for_thread(task_t task, thread_t thread);
+
+/*
+ * At most three backtraces per process name: a crash loop repeats the same frames, and the serial line
+ * cannot afford them. The comparison is a prefix because p_comm is cut to about fifteen characters, so a
+ * strcmp() could never match a longer name.
+ */
+#define OPI5PLUS_EXIT_UBT_NAMES 16
+#define OPI5PLUS_EXIT_UBT_PER_NAME 3
+static int
+opi5plus_exit_ubt_allowed(const char *comm)
+{
+	static char seen[OPI5PLUS_EXIT_UBT_NAMES][24];
+	static int counts[OPI5PLUS_EXIT_UBT_NAMES];
+	static int used;
+	int i;
+
+	for (i = 0; i < used; ++i) {
+		if (strncmp(seen[i], comm, 15) == 0) {
+			if (counts[i] >= OPI5PLUS_EXIT_UBT_PER_NAME) {
+				return 0;
+			}
+			counts[i]++;
+			return 1;
+		}
+	}
+	if (used == OPI5PLUS_EXIT_UBT_NAMES) {
+		return 0;
+	}
+	strlcpy(seen[used], comm, sizeof(seen[used]));
+	counts[used] = 1;
+	used++;
+	return 1;
+}
+
+void
+opi5plus_trace_exit(proc_t p, int rv)
+{
+	uint32_t head, tail;
+	struct opi5plus_exit_event *event;
+
+	if (!p || !opi5plus_exit_enabled()) {
+		return;
+	}
+	/*
+	 * exit(n) with n != 0, walked from the thread that is exiting: the only moment its user registers still
+	 * describe the frame that failed. W_EXITCODE puts n in bits 8..15 and leaves the low seven zero; a signal
+	 * death has them set and is already walked by opi5plus_crash_trace() (0005-crash-trace.patch), so it is
+	 * left alone here -- printing the same frames twice costs serial time and says nothing new.
+	 */
+	if ((rv & 0x7f) == 0 && ((rv >> 8) & 0xff) != 0 && opi5plus_exit_ubt_allowed(p->p_comm)) {
+		opi5plus_ubt_for_thread(proc_task(p), current_thread());
+	}
+	head = opi5plus_exit_head;
+	tail = opi5plus_exit_tail;
+	opi5plus_exit_total++;
+	if (head - tail >= OPI5PLUS_EXIT_RING) {
+		opi5plus_exit_dropped++;
+		return;
+	}
+	event = &opi5plus_exit_ring[head % OPI5PLUS_EXIT_RING];
+	strlcpy(event->name, p->p_comm, sizeof(event->name));
+	event->pid = proc_getpid(p);
+	event->rv = rv;
+	event->start = (long long)p->p_start.tv_sec;
+	opi5plus_exit_head = head + 1;
+}
+
+static void
+opi5plus_pe_hex(unsigned value)
+{
+	char digits[10];
+	int count = 0;
+
+	opi5plus_pe_char('0');
+	opi5plus_pe_char('x');
+	do {
+		unsigned nibble = value & 0xf;
+
+		digits[count++] = (char)(nibble < 10 ? '0' + nibble : 'a' + (nibble - 10));
+		value >>= 4;
+	} while (value != 0 && count < (int)sizeof(digits));
+	while (count > 0) {
+		opi5plus_pe_char(digits[--count]);
+	}
+}
+
+static void
+opi5plus_report_exits(void)
+{
+	uint32_t tail = opi5plus_exit_tail;
+	uint32_t head = opi5plus_exit_head;
+	unsigned budget = 24;
+	struct timeval now = {0, 0};
+	extern void microtime(struct timeval *tv);
+
+	if (!opi5plus_exit_enabled()) {
+		return;
+	}
+	/* Straight to the UART, like the beat line: the console's own lock is held for minutes at a time by
+	 * logd's ENOSPC storm, and printf there would wedge this thread and its auto-reboot timer with it. */
+	/* p_start is wall-clock (microtime_with_abstime), not an uptime: the age is taken against microtime(),
+	 * once per report and only when there is something to print. */
+	if (tail != head) {
+		microtime(&now);
+	}
+	while (tail != head && budget-- != 0) {
+		struct opi5plus_exit_event *event = &opi5plus_exit_ring[tail % OPI5PLUS_EXIT_RING];
+		int rv = event->rv;
+		int signal = rv & 0x7f;
+
+		/* W_EXITCODE(code, sig): a signal death is a signal number in the low seven bits, an exit(n)
+		 * is n in bits 8..15. */
+		opi5plus_pe_puts("\r\nopi5plus: exit ");
+		opi5plus_pe_puts(event->name);
+		opi5plus_pe_puts("[");
+		opi5plus_pe_number((unsigned long long)event->pid);
+		opi5plus_pe_puts("] rv ");
+		opi5plus_pe_hex((unsigned)rv);
+		opi5plus_pe_puts(" sig ");
+		opi5plus_pe_number((unsigned long long)(signal != 0x7f ? signal : 0));
+		opi5plus_pe_puts(" code ");
+		opi5plus_pe_number((unsigned long long)((rv >> 8) & 0xff));
+		opi5plus_pe_puts(" age ");
+		if (event->start == 0 || (long long)now.tv_sec < event->start) {
+			opi5plus_pe_puts("-1");
+		} else {
+			opi5plus_pe_number((unsigned long long)((long long)now.tv_sec - event->start));
+		}
+		tail++;
+	}
+	opi5plus_exit_tail = tail;
+	if (opi5plus_exit_head - opi5plus_exit_tail >= OPI5PLUS_EXIT_RING && opi5plus_exit_dropped != 0) {
+		opi5plus_pe_puts("\r\nopi5plus: exit records dropped ");
+		opi5plus_pe_number(opi5plus_exit_dropped);
+		opi5plus_pe_puts(" of ");
+		opi5plus_pe_number(opi5plus_exit_total);
+		opi5plus_exit_dropped = 0;
+	}
+}
